/* ===== SYNCED ARRIVAL TRAIN (message 105, PRESENTATION ONLY; pc_arrival_train.h; kill switch AC_MP_TRAIN_SYNC=0) =====
 * Included at the end of pc_net_game.c. HOST: the arrival timeline (pcat_host_*), its STATE broadcast and the passengers' REQUEST / STEPPED_OFF /
 * WELCOMED / ABORT. CLIENT: the last STATE (ages turned into local ms at receipt) and its own ops, sent only after the host's STATE arrived in this
 * session (an old host never sends one: the previous behaviour stays). Every role: the game-facing pc_arrtrain_* API (m_train_control.c,
 * ac_ride_off_demo_move.c_inc, ac_npc_station_master_schedule.c_inc). Nothing here writes a save, a pocket or the field. */

extern void mTRC_pc_train_params(PCATTrainParams* out); /* m_train_control.c: the game's mTRC_* constants */

static PCATQueue s_at_q;                 /* HOST: the timeline */
static int       s_at_q_init = 0;
static int       s_at_dirty = 0;
static uint32_t  s_at_seq = 0;           /* HOST: STATE counter */
static uint32_t  s_at_last_send_ms = 0;
static uint32_t  s_at_depart_total_ms = 28000u; /* HOST + view: depart signal -> gone (from the sim at the first use) */

typedef struct PCATClientTrain {
    PCArrTrainWire w;
    uint32_t       local_start_ms;  /* valid with PCAT_TF_START: local ms of the train start (first STATE that carried it) */
    uint32_t       local_depart_ms; /* valid with PCAT_TF_DEPART */
    uint8_t        start_known, depart_known;
} PCATClientTrain;
static PCATClientTrain s_at_ct[PCAT_MAX_TRAINS]; /* CLIENT: the latest STATE */
static int       s_at_cap = 0;           /* CLIENT: the host's STATE arrived in this session */
static uint32_t  s_at_cli_seq = 0;       /* CLIENT: the last applied STATE seq */
static uint32_t  s_at_op_seq = 0;        /* CLIENT: own op counter (logs) */
/* the local arrival's request (both roles): one per ride-off demo; a poll gap > 2 s starts a new one */
static int       s_at_req_active = 0, s_at_req_sent = 0, s_at_fallback = 0;
static uint32_t  s_at_req_ms = 0, s_at_req_last_poll_ms = 0;
static int       s_at_log_last_decide = -2;

static int pcnetgame_arrtrain_enabled(void) {
    static int s_on = -1;
    if (s_on < 0) {
        const char* e = getenv("AC_MP_TRAIN_SYNC");
        s_on = !(e != NULL && strcmp(e, "0") == 0);
        printf("[TRAIN][SYNC] synced arrival train: %s\n", s_on ? "ON" : "OFF (AC_MP_TRAIN_SYNC=0: every process runs its own arrival train, as before)");
    }
    return s_on;
}

static void pcnetgame_arrtrain_q_init(void) {
    if (!s_at_q_init) {
        PCATTrainParams p;
        uint32_t arrive_ms;
        mTRC_pc_train_params(&p);
        arrive_ms = pcat_frames_to_ms(pcat_sim_arrive_frames(&p));
        s_at_depart_total_ms = pcat_frames_to_ms(pcat_sim_depart_frames(&p)) + 500u;
        pcat_queue_init(&s_at_q, arrive_ms, s_at_depart_total_ms);
        s_at_q_init = 1;
        printf("[TRAIN][SYNC] timeline: arrival %u ms (train start -> doors open), departure %u ms (signal -> gone), next train %u ms after a departure\n", (unsigned)arrive_ms,
               (unsigned)s_at_depart_total_ms, (unsigned)PCAT_CLEAR_MS);
    }
}

static int pcnetgame_arrtrain_local_wire_id(void) {
    return s_role == PC_NETGAME_ROLE_HOST ? (int)PC_NETGAME_HOST_WIRE_ID : (int)s_client_assigned_peer_id;
}

static void pcnetgame_arrtrain_log_state(const char* who, const PCArrTrainMsg* m) {
    int t;
    printf("[TRAIN][SYNC] %s: STATE seq %u, %u train(s)", who, (unsigned)m->seq, (unsigned)m->n_trains);
    for (t = 0; t < (int)m->n_trains; t++) {
        const PCArrTrainWire* w = &m->train[t];
        int k;
        printf(" | train %u%s%s age %d ms%s", (unsigned)w->id, (w->flags & PCAT_TF_START) ? "" : " (queued)", (w->flags & PCAT_TF_DEPART) ? " DEPARTING" : "",
               (w->flags & PCAT_TF_START) ? (int)w->start_ago_ms : 0, w->n ? ":" : " (no passenger)");
        for (k = 0; k < (int)w->n; k++) {
            static const char* const k_ps[] = { "riding", "off", "welcomed", "gone" };
            printf(" %u=%s", (unsigned)w->peer[k], k_ps[w->pstate[k] & 3u]);
        }
    }
    printf("\n");
}

/* ---- HOST ---- */
static void pcnetgame_arrtrain_host_send(int only_peer) {
    PCArrTrainMsg m;
    const uint32_t now = pcnetgame_now_ms();
    int p, n = 0;
    pcat_build_state(&s_at_q, now, s_at_seq, &m);
    for (p = 0; p < pcnetgame_peer_span(); p++) {
        if ((only_peer < 0 || p == only_peer) && s_host_peer_link[p] == PC_NETGAME_LINK_READY) {
            if (pc_net_send((PCNetPeerId)p, PC_NET_RELIABLE, &m, (uint16_t)sizeof(m))) {
                n++;
            }
        }
    }
    (void)n;
}

static void pcnetgame_arrtrain_host_broadcast(const char* why) {
    PCArrTrainMsg m;
    s_at_seq++;
    s_at_last_send_ms = pcnetgame_now_ms();
    pcnetgame_arrtrain_host_send(-1);
    if (why != NULL) {
        pcat_build_state(&s_at_q, s_at_last_send_ms, s_at_seq, &m);
        printf("[TRAIN][SYNC] host: %s -> ", why);
        pcnetgame_arrtrain_log_state("broadcast", &m);
    }
}

/* at READY (before the snapshot, so a joining guest knows the timeline before it decides its arrival) */
static void pcnetgame_arrtrain_host_on_ready(PCNetPeerId peer) {
    if (s_role != PC_NETGAME_ROLE_HOST || !pcnetgame_arrtrain_enabled()) {
        return;
    }
    pcnetgame_arrtrain_q_init();
    s_at_seq++;
    pcnetgame_arrtrain_host_send((int)peer);
    printf("[TRAIN][SYNC] host: STATE seq %u sent to peer %d at READY (%d train(s))\n", (unsigned)s_at_seq, (int)peer, s_at_q.train[0].used + s_at_q.train[1].used);
}

static void pcnetgame_arrtrain_host_seat(uint8_t who, const char* src) {
    int t = -1, k = -1, r;
    const uint32_t now = pcnetgame_now_ms();
    pcnetgame_arrtrain_q_init();
    r = pcat_host_request(&s_at_q, who, now, &t, &k);
    if (r == PCAT_REQ_FULL) {
        printf("[TRAIN][SYNC] host: %s %u asks for a seat: both trains are taken (it arrives the previous way)\n", src, (unsigned)who);
        return;
    }
    printf("[TRAIN][SYNC] host: %s %u -> train %u seat %d (%s)\n", src, (unsigned)who, (unsigned)s_at_q.train[t].id, k,
           r == PCAT_REQ_ALREADY ? "already seated" : r == PCAT_REQ_SEATED_NEW ? (s_at_q.train[t].start_set && s_at_q.train[t].start_ms != now ? "a NEW train, after the departing one" :
                                                                                  s_at_q.train[t].start_set ? "a NEW train, starting now" : "a NEW train, after the full one departs")
                                          : "joins the train at / coming to the station");
    if (r != PCAT_REQ_ALREADY) {
        s_at_dirty = 1;
    }
}

static void pcnetgame_handle_host_arrtrain(PCNetPeerId peer, const uint8_t* data, uint16_t size) {
    PCArrTrainMsg m;
    if (!pcnetgame_arrtrain_enabled() || size != sizeof(PCArrTrainMsg) || peer < 0 || peer >= pcnetgame_peer_span() || s_host_peer_link[peer] != PC_NETGAME_LINK_READY) {
        return; /* dropped (never a violation) */
    }
    memcpy(&m, data, sizeof(m));
    if (!pcat_msg_ok(&m) || m.op == PCAT_OP_STATE) {
        printf("[TRAIN][SYNC] host: peer %d malformed op dropped\n", (int)peer);
        return;
    }
    if (m.op == PCAT_OP_REQUEST) {
        pcnetgame_arrtrain_host_seat((uint8_t)peer, "peer");
        return;
    }
    pcnetgame_arrtrain_q_init();
    if (pcat_host_progress(&s_at_q, (uint8_t)peer, m.op, pcnetgame_now_ms())) {
        printf("[TRAIN][SYNC] host: peer %d %s\n", (int)peer, m.op == PCAT_OP_STEPPED_OFF ? "stepped off the train" : m.op == PCAT_OP_WELCOMED ? "was welcomed by Porter" : "gave up its seat");
        s_at_dirty = 1;
    }
}

static void pcnetgame_arrtrain_host_tick(void) {
    const uint32_t now = pcnetgame_now_ms();
    int t, k;
    if (s_role != PC_NETGAME_ROLE_HOST || !pcnetgame_arrtrain_enabled()) {
        return;
    }
    pcnetgame_arrtrain_q_init();
    for (t = 0; t < PCAT_MAX_TRAINS; t++) { /* a passenger whose connection went away never holds a train */
        PCATTrain* tr = &s_at_q.train[t];
        for (k = 0; tr->used && k < (int)tr->n; k++) {
            const int p = (int)tr->pass[k].peer;
            if (p != (int)PC_NETGAME_HOST_WIRE_ID && (p >= pcnetgame_peer_span() || s_host_peer_link[p] != PC_NETGAME_LINK_READY) && pcat_host_peer_gone(&s_at_q, (uint8_t)p)) {
                printf("[TRAIN][SYNC] host: passenger %d left the session\n", p);
                s_at_dirty = 1;
            }
        }
    }
    if (pcat_host_tick(&s_at_q, now)) {
        s_at_dirty = 1;
    }
    if (s_at_dirty) {
        s_at_dirty = 0;
        pcnetgame_arrtrain_host_broadcast("timeline changed");
    } else if (pcat_any_train(&s_at_q) && (uint32_t)(now - s_at_last_send_ms) >= PCAT_RESEND_MS) {
        pcnetgame_arrtrain_host_broadcast(NULL);
    }
}

/* ---- CLIENT ---- */
static void pcnetgame_arrtrain_client_reset(void) {
    memset(s_at_ct, 0, sizeof(s_at_ct));
    s_at_cap = 0;
    s_at_cli_seq = 0;
    s_at_req_active = 0;
    s_at_req_sent = 0;
    s_at_fallback = 0;
}

static void pcnetgame_handle_client_arrtrain(const uint8_t* data, uint16_t size) {
    PCArrTrainMsg m;
    PCATClientTrain nt[PCAT_MAX_TRAINS];
    const uint32_t now = pcnetgame_now_ms();
    int t, o;
    if (!pcnetgame_arrtrain_enabled() || size != sizeof(PCArrTrainMsg)) {
        return;
    }
    memcpy(&m, data, sizeof(m));
    if (!pcat_msg_ok(&m) || m.op != PCAT_OP_STATE) {
        printf("[TRAIN][SYNC] client: malformed STATE dropped\n");
        return;
    }
    if (s_at_cap && (int32_t)(m.seq - s_at_cli_seq) <= 0) {
        return; /* stale / duplicate */
    }
    memset(nt, 0, sizeof(nt));
    for (t = 0; t < (int)m.n_trains; t++) {
        nt[t].w = m.train[t];
        for (o = 0; o < PCAT_MAX_TRAINS; o++) { /* keep the first local start / depart computed for this train id (no jitter once it runs) */
            if (s_at_ct[o].w.id == m.train[t].id && (s_at_ct[o].w.flags & PCAT_TF_USED)) {
                nt[t].start_known = s_at_ct[o].start_known;
                nt[t].local_start_ms = s_at_ct[o].local_start_ms;
                nt[t].depart_known = s_at_ct[o].depart_known;
                nt[t].local_depart_ms = s_at_ct[o].local_depart_ms;
            }
        }
        if ((m.train[t].flags & PCAT_TF_START) && !nt[t].start_known) {
            nt[t].start_known = 1;
            nt[t].local_start_ms = now - (uint32_t)m.train[t].start_ago_ms;
        }
        if ((m.train[t].flags & PCAT_TF_DEPART) && !nt[t].depart_known) {
            nt[t].depart_known = 1;
            nt[t].local_depart_ms = now - (uint32_t)m.train[t].depart_ago_ms;
        }
    }
    memcpy(s_at_ct, nt, sizeof(s_at_ct));
    if (!s_at_cap || m.n_trains > 0 || s_at_cli_seq == 0) {
        pcnetgame_arrtrain_log_state(s_at_cap ? "client" : "client (the host runs the synced arrival train)", &m);
    }
    s_at_cap = 1;
    s_at_cli_seq = m.seq;
}

static void pcnetgame_arrtrain_client_send(unsigned op) {
    PCArrTrainMsg m;
    memset(&m, 0, sizeof(m));
    m.msg_type = (uint8_t)PCAT_MSG_ID;
    m.op = (uint8_t)op;
    m.version = 1u;
    m.seq = ++s_at_op_seq;
    if (s_role == PC_NETGAME_ROLE_CLIENT && s_client_link == PC_NETGAME_LINK_READY && s_at_cap) {
        (void)pc_net_send(0, PC_NET_RELIABLE, &m, (uint16_t)sizeof(m));
    }
}

/* ---- every role: the presented train ---- */
int pc_arrtrain_active(void) {
    if (!pcnetgame_arrtrain_enabled()) {
        return 0;
    }
    if (s_role == PC_NETGAME_ROLE_HOST) {
        return 1;
    }
    return s_role == PC_NETGAME_ROLE_CLIENT && s_client_link == PC_NETGAME_LINK_READY && s_at_cap;
}

/* one train of the timeline in the view's terms (local ms); 0 = unused */
static int pcnetgame_arrtrain_get(int t, uint32_t now, PCATView* v) {
    int k;
    memset(v, 0, sizeof(*v));
    v->local_idx = -1;
    if (s_role == PC_NETGAME_ROLE_HOST) {
        const PCATTrain* tr = &s_at_q.train[t];
        if (!s_at_q_init || !tr->used) {
            return 0;
        }
        v->id = tr->id;
        v->started = tr->start_set;
        v->age_ms = tr->start_set ? (int32_t)(now - tr->start_ms) : INT32_MIN;
        v->depart_set = tr->depart_set;
        v->depart_age_ms = tr->depart_set ? (int32_t)(now - tr->depart_ms) : 0;
        v->n = tr->n;
        for (k = 0; k < PCAT_MAX_PASS; k++) {
            v->peer[k] = k < (int)tr->n ? tr->pass[k].peer : (uint8_t)PCAT_PEER_NONE;
            v->pstate[k] = k < (int)tr->n ? tr->pass[k].state : 0u;
        }
    } else {
        const PCATClientTrain* ct = &s_at_ct[t];
        if (!(ct->w.flags & PCAT_TF_USED)) {
            return 0;
        }
        v->id = ct->w.id;
        v->started = ct->start_known;
        v->age_ms = ct->start_known ? (int32_t)(now - ct->local_start_ms) : INT32_MIN;
        v->depart_set = ct->depart_known;
        v->depart_age_ms = ct->depart_known ? (int32_t)(now - ct->local_depart_ms) : 0;
        v->n = ct->w.n;
        for (k = 0; k < PCAT_MAX_PASS; k++) {
            v->peer[k] = ct->w.peer[k];
            v->pstate[k] = ct->w.pstate[k];
        }
    }
    v->has_train = 1;
    if (v->started && v->age_ms < 0) {
        v->started = 0; /* starts in the future */
    }
    return 1;
}

int pc_arrtrain_view(PCATView* out) {
    const uint32_t now = pcnetgame_now_ms();
    const int me = pcnetgame_arrtrain_local_wire_id();
    PCATView v;
    int t, k, chosen = 0;
    memset(out, 0, sizeof(*out));
    out->local_idx = -1;
    if (!pc_arrtrain_active()) {
        return 0;
    }
    for (t = PCAT_MAX_TRAINS - 1; t >= 0; t--) { /* newest first: a started next train supersedes the one pulling out (it is off the station by then) */
        if (!pcnetgame_arrtrain_get(t, now, &v)) {
            continue;
        }
        for (k = 0; k < v.n; k++) {
            if ((int)v.peer[k] == me && v.pstate[k] != PCAT_PS_GONE) {
                v.local_idx = k;
            }
        }
        if (v.local_idx >= 0 && !out->local_seat_train) {
            out->local_seat_train = 1;
            out->local_seat_started = v.age_ms != INT32_MIN;
            out->local_seat_age_ms = v.age_ms;
        }
        /* the presented train: the newest that has started and has not finished pulling out */
        if (!chosen && v.started && !(v.depart_set && v.depart_age_ms >= (int32_t)s_at_depart_total_ms)) {
            const int seat = out->local_seat_train, seat_started = out->local_seat_started;
            const int32_t seat_age = out->local_seat_age_ms;
            *out = v;
            out->local_seat_train = seat;
            out->local_seat_started = seat_started;
            out->local_seat_age_ms = seat_age;
            chosen = 1;
        }
    }
    if (!chosen) {
        out->has_train = 0;
        out->local_idx = -1;
    }
    return 1;
}

int pc_arrtrain_peer_is_passenger(int peer) {
    const uint32_t now = pcnetgame_now_ms();
    PCATView v;
    int t, k;
    if (!pc_arrtrain_active()) {
        return 0;
    }
    for (t = 0; t < PCAT_MAX_TRAINS; t++) {
        if (pcnetgame_arrtrain_get(t, now, &v)) {
            for (k = 0; k < v.n; k++) {
                if ((int)v.peer[k] == peer && v.pstate[k] != PCAT_PS_GONE) {
                    return 1;
                }
            }
        }
    }
    return 0;
}

int pc_arrtrain_passenger_pos(int peer, float* x, float* z) {
    float y;
    if (peer == pcnetgame_arrtrain_local_wire_id() || peer < 0 || peer >= 255) {
        return 0;
    }
    return pc_remote_player_get_draw_position((PCNetPlayerId)peer, x, &y, z);
}

int pc_arrtrain_local_seated(void) {
    PCATView v;
    return pc_arrtrain_view(&v) && v.has_train && v.local_idx >= 0;
}

int pc_arrtrain_arrival_query(void) {
    const uint32_t now = pcnetgame_now_ms();
    PCATView v;
    int capable, d;
    if (!pcnetgame_arrtrain_enabled() || (s_role != PC_NETGAME_ROLE_HOST && s_role != PC_NETGAME_ROLE_CLIENT)) {
        return 0;
    }
    if (!s_at_req_active || (uint32_t)(now - s_at_req_last_poll_ms) > 2000u) { /* a new ride-off demo */
        s_at_req_active = 1;
        s_at_req_sent = 0;
        s_at_fallback = 0;
        s_at_log_last_decide = -2;
    }
    s_at_req_last_poll_ms = now;
    if (s_at_fallback) {
        return 0; /* this arrival already fell back (no seat in time): the previous behaviour, never a second request */
    }
    capable = pc_arrtrain_active();
    if (capable && !s_at_req_sent) {
        s_at_req_sent = 1;
        s_at_req_ms = now;
        if (s_role == PC_NETGAME_ROLE_HOST) {
            pcnetgame_arrtrain_host_seat((uint8_t)PC_NETGAME_HOST_WIRE_ID, "the host's own player");
            pcnetgame_arrtrain_host_tick(); /* broadcast at once */
        } else {
            pcnetgame_arrtrain_client_send(PCAT_OP_REQUEST);
            printf("[TRAIN][SYNC] client: arrival: asked the host for a seat on the arrival train (peer %u)\n", (unsigned)s_client_assigned_peer_id);
        }
    }
    (void)pc_arrtrain_view(&v);
    d = pcat_client_arrival_decide(capable && s_at_req_sent, s_at_req_sent ? (uint32_t)(now - s_at_req_ms) : 0u, v.local_seat_train, v.local_seat_started, v.local_seat_age_ms);
    if (d != s_at_log_last_decide) {
        s_at_log_last_decide = d;
        if (d < 0) {
            printf("[TRAIN][SYNC] arrival: holding at the train start (%s)\n", v.local_seat_train ? "the seat's train has not started yet" : "waiting for the host's seat");
            pc_net_game_join_trace("arrival: synced train: holding (%s)", v.local_seat_train ? "train not started yet" : "waiting for a seat");
        } else if (d == 1) {
            printf("[TRAIN][SYNC] arrival: SYNCED: seat %d on train %u (train age %d ms)\n", v.local_idx, (unsigned)v.id, (int)v.age_ms);
            pc_net_game_join_trace("arrival: synced train %u seat %d", (unsigned)v.id, v.local_idx);
        } else if (capable && s_at_req_sent) {
            printf("[TRAIN][SYNC] arrival: no usable seat after %u ms -> the previous arrival behaviour\n", (unsigned)(now - s_at_req_ms));
            pc_arrtrain_local_progress(PCAT_OP_ABORT);
        }
    }
    if (d == 0 && s_at_req_sent) {
        s_at_fallback = 1; /* sticky for this ride-off demo (the previous path may still hold it a while: no new request meanwhile) */
    }
    return d;
}

void pc_arrtrain_local_progress(unsigned op) {
    const uint32_t now = pcnetgame_now_ms();
    PCATView v;
    int t, k, seated = 0;
    if (!pc_arrtrain_active()) {
        return;
    }
    for (t = 0; t < PCAT_MAX_TRAINS && !seated; t++) {
        if (pcnetgame_arrtrain_get(t, now, &v)) {
            for (k = 0; k < v.n; k++) {
                if ((int)v.peer[k] == pcnetgame_arrtrain_local_wire_id() && v.pstate[k] != PCAT_PS_GONE) {
                    seated = 1;
                }
            }
        }
    }
    if (!seated) {
        return;
    }
    printf("[TRAIN][SYNC] local passenger: %s\n", op == PCAT_OP_STEPPED_OFF ? "stepped off" : op == PCAT_OP_WELCOMED ? "welcomed by Porter" : "gives up its seat");
    if (s_role == PC_NETGAME_ROLE_HOST) {
        if (pcat_host_progress(&s_at_q, (uint8_t)PC_NETGAME_HOST_WIRE_ID, op, now)) {
            s_at_dirty = 1;
        }
    } else {
        pcnetgame_arrtrain_client_send(op);
    }
}
/* ===== SYNCED ARRIVAL TRAIN END ===== */
