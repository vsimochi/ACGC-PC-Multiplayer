# IDE folders
.idea/
.vs/
.vscode/*

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
build32/
build64/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
!requirements.txt
*.exe

# For saving work files into (like IDB)
temp/

# Ignore the N64 SDK headers since we download them
# NOTE: include/PR/gbi.h and include/PR/ultratypes.h are force-tracked
# (git add -f) because they have TARGET_PC modifications for LE bitfields.
# configure.py skips download when they already exist.
include/PR/
include/gcc/
include/compiler/gcc/stdlib.h

# Multiplayer test output (net_spike tests write logs and run output next to the scripts)
pc/tools/net_spike/*.log
pc/tools/net_spike/logs/
pc/tools/net_spike/ac_auto_*.txt
pc/tools/net_spike/regress_*.txt
pc/tools/net_spike/reg_*.txt
pc/tools/net_spike/full_*.txt
pc/tools/net_spike/life*.txt
pc/tools/net_spike/proxycap_*.txt
pc/tools/net_spike/*_run.txt
pc/tools/net_spike/*_run?.txt
pc/tools/net_spike/run_?.txt
pc/tools/net_spike/pres_life.txt
pc/tools/net_spike/final_sim_full.txt
pc/tools/net_spike/wild_regress_summary.txt

# Per-machine runtime config the game writes next to wherever it was started
/settings.ini
/keybindings.ini

# Disposable evidence output of the wildlife test sprints (kept locally, summarised in TODO.md)
pc/tools/net_spike/ws[0-9]_*.txt
pc/tools/net_spike/ws[0-9]_*/
pc/tools/net_spike/proto_*.txt
pc/tools/net_spike/stab_*.txt
pc/tools/net_spike/stab_chain*/
pc/tools/net_spike/routine_*.txt
pc/tools/net_spike/ant_repeat.txt
pc/tools/net_spike/bench_*_baseline.txt
pc/ws_clean_build*.txt
pc/routine_build.txt
