static int Player_actor_request_main_notice_rod(GAME* game, s16 angle, int priority) {
    if (Player_actor_check_request_main_able(game, mPlayer_INDEX_NOTICE_ROD, priority)) {
        PLAYER_ACTOR* player = GET_PLAYER_ACTOR_GAME(game);

        Player_actor_request_main_index(game, mPlayer_INDEX_NOTICE_ROD, priority);

        player->requested_main_index_data.notice_rod.angle_y = angle;

        return TRUE;
    }

    return FALSE;
}

static void Player_actor_setup_main_Notice_rod(ACTOR* actor, GAME* game) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actor;
    mPlayer_main_notice_rod_c* main_notice = &player->main_data.notice_rod;
    mPlayer_request_notice_rod_c* req_notice = &player->requested_main_index_data.notice_rod;
    UKI_ACTOR* uki;
    int type;

    main_notice->timer = 0.0f;
    main_notice->state = 0;
    main_notice->angle_y = req_notice->angle_y;
    main_notice->exchange_flag = FALSE;
    main_notice->already_collected = FALSE;
    main_notice->end_effect_flag = FALSE;

    uki = (UKI_ACTOR*)player->fishing_rod_actor_p;
    type = uki->gyo_type;

    if (uki != NULL && type >= aGYO_TYPE_CRUCIAN_CARP) {
        int free_space = mPlib_Get_space_putin_item();

#ifdef TARGET_PC
        /* World Ecology Wildlife Sync T-catch (ordinary fish catching only -- see this milestone's own
         * ABSOLUTE SCOPE LIMIT: no bug catching, tournaments, or ant/bee special-case handling).
         *
         * Point of no return already passed (aUKI_bite(), ac_uki_move.c_inc: uki->gyo_status = 5) by the
         * time this function ever runs -- the catch itself is already guaranteed; only WHO grants the
         * item, and WHEN, changes here. Option A (see this milestone's design brief): defer the actual
         * grant until the HOST accepts, rather than granting optimistically and trying to claw it back
         * later (no precedent for that anywhere in this codebase). `main_notice->not_full_pocket` is
         * still driven purely by the local free-slot check alone, exactly like vanilla -- the release-
         * or-keep dialogue flow is completely unchanged regardless of whether the host has answered yet
         * (see Player_actor_MessageControl_Notice_rod(), further down this file: its own release-choice
         * default case never needed a change).
         *
         * Bug fix (post-T3 review): a full-pockets catch (free_space < 0) STILL goes through the network
         * path below -- it must, because the host's authoritative record for this entity has to be
         * removed and the despawn broadcast exactly once for every successful vanilla catch, regardless
         * of what the player's pockets look like. An earlier revision gated the whole block on
         * `free_space >= 0`, which meant a full-pockets catch never told the host at all; the player would
         * then choose "exchange" from the release-or-keep dialogue (Player_actor_request_proc_index_
         * fromPutaway_rod(), m_player_main_putaway_rod.c_inc) and be granted the item there with ZERO host
         * involvement -- leaving the fish live and catchable by someone else too (double-award). The fix:
         * still send CATCH_REQUEST / still run the host-local resolve when pockets are full, just with a
         * local grant amount of 0 (nothing CAN be granted into a full pocket) -- the release-or-exchange
         * UI choice itself stays local/vanilla either way, since no shared-world state is at risk once the
         * request has been sent (or the host-local resolve has already run).
         *
         * already_collected (the READ-ONLY mSM_CHECK_LAST_FISH_GET() check) is still computed
         * immediately below, unconditionally, so the dialogue text is correct either way; only the
         * WRITE (mSM_COLLECT_FISH_SET()) is deferred alongside the grant -- see the branches below. */
        {
            int grant_handled = FALSE;

            if (type < aGYO_TYPE_NUM + 1) {
                main_notice->already_collected = mSM_CHECK_LAST_FISH_GET(type);
            }

            if (pc_net_game_authoritative_wildlife_enabled()) {
                /* pcfa_scene_is_town()/save-loaded/etc. are re-checked internally by both
                   pc_net_game_request_catch_fish() and pc_net_game_host_local_wildlife_catch() (see
                   their own doc, pc_net_game.h) -- not duplicated here, since neither is otherwise
                   reachable from this file without a new pc_field_authority.h include.

                   NOTE: this branch is intentionally reached even when free_space < 0 (full pockets) --
                   see this call site's own top-of-block doc for why (Bug fix, post-T3 review). */
                uint32_t entity_id =
                    (uki->child_actor != NULL) ? aGYO_pc_get_entity_id_stamp(uki->child_actor) : 0;

                if (entity_id != 0 && pc_net_game_world_is_host_authoritative()) {
                    /* Host-authoritative client: send CATCH_REQUEST; the grant + collection-bit commit
                       happen later, on CATCH_RESULT accept (pcnetgame_handle_client_catch_result(),
                       pc_net_game.c) -- see pc_net_game_request_catch_fish()'s own doc. Full pockets:
                       local_item is 0 (nothing can be granted into a full pocket) -- the host is still
                       told about the catch so its authoritative record is removed and the despawn
                       broadcast either way; pcnetgame_handle_client_catch_result() already treats
                       local_grant == 0 as "accepted, nothing to grant" (it still commits the
                       collection-bit). */
                    mActor_name_t local_item = (free_space >= 0) ? uki->get_fish_type_proc(&uki->actor_class) : 0;
                    if (pc_net_game_request_catch_fish(entity_id, type, (int)local_item)) {
                        grant_handled = TRUE;
                    } else {
                        /* M9-D L-3: a READY client with the authoritative seam ON and a stamped entity,
                           but the request could not be sent (not in town / no owner stamp). The host still
                           holds the entity live, so the vanilla grant would be a duplicate: deny locally,
                           same as the disconnected-client branch below. */
                        pc_net_game_record_local_catch_denied(entity_id);
                        grant_handled = TRUE;
                    }
                } else if (entity_id != 0 && pc_net_game_role() == PC_NETGAME_ROLE_HOST) {
                    /* Host's own local catch: resolves synchronously against the authoritative table
                       (races against any peer's own simultaneous claim on the SAME entity_id) -- the
                       vanilla grant + collection-bit write below run UNMODIFIED only if accepted, with
                       NO network round-trip to itself. Either way (accepted or rejected) this decision
                       is now fully resolved -- never fall through to the plain vanilla branch below,
                       which would double-grant on acceptance. Full pockets: the entity is still removed
                       from the authoritative table and the despawn still broadcast on accept, just
                       without ever calling Player_actor_putin_item() (nothing can be granted into a full
                       pocket) -- same fix rationale as the client branch above. */
                    if (pc_net_game_host_local_wildlife_catch(entity_id, type)) {
                        if (free_space >= 0) {
                            Player_actor_putin_item(free_space, uki->get_fish_type_proc(&uki->actor_class), NULL);
                        }
                        if (type < aGYO_TYPE_NUM + 1) {
                            mSM_COLLECT_FISH_SET(type);
                        }
                    }
                    grant_handled = TRUE;
                } else if (entity_id != 0 && pcwld_should_suppress_local_wildlife()) {
                    /* T8 audit fix (Bug 3): a DISCONNECTED client (role still CLIENT, link no longer
                       READY -- pc_net_game_world_is_host_authoritative() above is FALSE for exactly this
                       reason) used to fall all the way through to the plain vanilla grant below for a
                       fish that WAS tracked (entity_id != 0), silently handing out an item the host may
                       still consider live and catchable by someone else -- an unauthoritative duplicate.
                       No host to ask right now, so deny the grant locally instead (same observable outcome
                       as a host REJECT via pcnetgame_handle_client_catch_result(): no item, no collection-
                       bit write) rather than risk a double-award once reconnected. */
                    printf("[NET][WILDLIFE] client: fish entity %u catch denied locally -- disconnected "
                           "(Bug 3 fix, see pc_wildlife_authority.h's own pcwld_should_suppress_local_"
                           "wildlife() doc)\n",
                           (unsigned)entity_id);
                    /* M9-D F2: record the denial so the putaway exchange gate (full pockets) also denies
                       the exchange; otherwise the query returns NONE and the exchange grants a duplicate. */
                    pc_net_game_record_local_catch_denied(entity_id);
                    grant_handled = TRUE;
                } else if (entity_id == 0 && pcwld_should_suppress_local_wildlife()) {
                    /* A client under host-authoritative wildlife whose fish carries no entity stamp (a leftover of a superseded session, or one whose actor could not be recovered):
                       the host has no record of it, so a vanilla grant would hand out a fish the authoritative table never had -- and, for a fish that IS still live there, a duplicate.
                       Deny it, exactly like a host REJECT: no item, no collection-bit write. */
                    printf("[NET][WILDLIFE] client: catch of an untracked fish denied locally (no entity stamp: leftover of a superseded wildlife session)\n");
                    grant_handled = TRUE;
                }
                /* entity_id == 0 (no stamp -- e.g. this fish predates T-catch tracking, or its actor
                   could not be recovered when it was materialized; see pcwld_presentation_create()'s own
                   residual-gap doc, pc_wildlife_authority.c): falls through to the plain vanilla grant
                   below rather than silently losing a real catch. */
            }

            if (!grant_handled) {
                if (free_space >= 0) {
                    Player_actor_putin_item(free_space, uki->get_fish_type_proc(&uki->actor_class), NULL);
                }
                if (type < aGYO_TYPE_NUM + 1) {
                    mSM_COLLECT_FISH_SET(type);
                }
            }

            main_notice->not_full_pocket = (free_space >= 0) ? TRUE : FALSE;
        }
#else
        if (free_space >= 0) {
            Player_actor_putin_item(free_space, uki->get_fish_type_proc(&uki->actor_class), NULL);
            main_notice->not_full_pocket = TRUE;
        } else {
            main_notice->not_full_pocket = FALSE;
        }

        if (type < aGYO_TYPE_NUM + 1) {
            main_notice->already_collected = mSM_CHECK_LAST_FISH_GET(type);
            mSM_COLLECT_FISH_SET(type);
        }
#endif
    } else {
        main_notice->not_full_pocket = FALSE;
    }

    if (type == aGYO_TYPE_BARRED_KNIFEJAW) {
        mISL_SetNowPlayerAction(mISL_PLAYER_ACTION_NOTICE_FISHING_ROD);
    }
    Player_actor_InitAnimation_Base2(actor, game, mPlayer_ANIM_GET_T2, mPlayer_ANIM_GET_T2, 1.0f, 1.0f, 0.5f, -3.0f, 0,
                                     0);
    Player_actor_setup_main_Base(actor, game);
}

static void Player_actor_settle_main_Notice_rod(ACTOR* actor, GAME* game) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actor;
    mPlayer_main_notice_rod_c* main_notice = &player->main_data.notice_rod;

    if (!main_notice->already_collected) {
        mBGMPsComp_delete_ps_fanfare(0x28, 0x168);
    } else {
        mBGMPsComp_delete_ps_fanfare(0x4C, 0x168);
    }
}

static void Player_actor_Movement_Notice_rod(ACTOR* actor) {
    add_calc_short_angle2(&actor->shape_info.rotation.y, 0, 1.0f - sqrtf(0.5), 2500, 50);
    actor->world.angle.y = actor->shape_info.rotation.y;
    Player_actor_Movement_Base_Braking_common(actor, 0.32625001f);
}

static int Player_actor_CulcAnimation_Notice_rod(ACTOR* actor, f32* frame_calc) {
    return Player_actor_CulcAnimation_Base2(actor, frame_calc);
}

static void Player_actor_set_eye_pattern_Notice_rod(ACTOR* actor, int end_flag) {
    if (end_flag) {
        Player_actor_set_eye_pattern_normal(actor);
    } else {
        Player_actor_set_tex_anime_pattern(actor);
    }
}

static void Player_actor_ObjCheck_Notice_rod(ACTOR* actor, GAME* game) {
    Player_actor_Excute_Corect_forStand(actor, game);
}

static void Player_actor_BGcheck_Notice_rod(ACTOR* actor) {
    Player_actor_BGcheck_common_type1(actor);
}

static void Player_actor_SearchAnimation_Notice_rod(ACTOR* actor, GAME* game, f32 frame) {
    if (!Player_actor_Check_AnimationFrame_PerfectEquel(actor, frame)) {
        Player_actor_Set_FootMark_Base1(actor, game, FALSE, FALSE);
    }
}

static void Player_actor_AppearMark_Notice_rod(ACTOR* actor) {
    static int use_mark_gyoei_type = aGYO_TYPE_KILLIFISH;

    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actor;
    mPlayer_main_notice_rod_c* main_notice = &player->main_data.notice_rod;

    if (!main_notice->end_effect_flag) {
        UKI_ACTOR* uki = (UKI_ACTOR*)player->fishing_rod_actor_p;

        if (uki != NULL) {
            int type = uki->gyo_type;

            if (type >= aGYO_TYPE_CRUCIAN_CARP) {
                int killfish = FALSE;

                if (type == use_mark_gyoei_type) {
                    killfish = TRUE;
                }

                if (killfish) {
                    Common_Get(clip).effect_clip->effect_make_proc(eEC_EFFECT_YAJIRUSHI, player->left_hand_pos, 2, 0,
                                                                   gamePT, RSV_NO, 0, 0);
                    main_notice->end_effect_flag = TRUE;
                }
            }
        }
    }
}

static void Player_actor_DeleteMark_Notice_rod(ACTOR* actor) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actor;
    mPlayer_main_notice_rod_c* main_notice = &player->main_data.notice_rod;

    if (main_notice->end_effect_flag) {
        Common_Get(clip).effect_clip->effect_kill_proc(eEC_EFFECT_YAJIRUSHI, RSV_NO);
        main_notice->end_effect_flag = FALSE;
    }
}

static int Player_actor_Get_sakana_msg_num(int msg_offs) {
    int ret_msg_no = msg_offs + 0x2FA9;

    if (msg_offs < 0x20) {
        ret_msg_no = msg_offs + 0x1327;
    }

    return ret_msg_no;
}

static void Player_actor_Notice_rod_demo_ct(ACTOR* actor) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actor;
    rgba_t color;
    mMsg_Window_c* win = mMsg_Get_base_window_p();
    UKI_ACTOR* uki = (UKI_ACTOR*)player->fishing_rod_actor_p;
    int msg_no = 0x1327;

    if (uki != NULL) {
        int type = uki->gyo_type;

        if (type >= aGYO_TYPE_CRUCIAN_CARP) {
            if (type < aGYO_TYPE_NUM + 1) {
                if (player->now_main_index == mPlayer_INDEX_NOTICE_ROD) {
                    mPlayer_main_notice_rod_c* main_notice = &player->main_data.notice_rod;
                    u8 str[mIN_ITEM_NAME_LEN];

                    if (main_notice->already_collected) {
                        mIN_copy_name_str(str, uki->get_fish_type_proc(&uki->actor_class));
                        mMsg_Set_item_str_art(win, mMsg_ITEM_STR0, str, sizeof(str),
                                              mIN_get_item_article(uki->get_fish_type_proc(&uki->actor_class)));
                        msg_no = 0x1349;
                    } else {
                        msg_no = Player_actor_Get_sakana_msg_num(type);
                    }
                } else {
                    msg_no = Player_actor_Get_sakana_msg_num(type);
                }
            } else {
                msg_no = type + 0x1997;
            }
        }
    }

    mDemo_Set_msg_num(msg_no);
    mDemo_Set_talk_display_name(FALSE);
    mDemo_Set_camera(CAMERA2_PROCESS_ITEM);
    mDemo_Set_ListenAble();
    mMsg_Set_LockContinue(win);

    color.r = 185;
    color.g = 245;
    color.b = 80;
    color.a = 255;

    mDemo_Set_talk_window_color(&color);
    mChoice_Clear_ChoseNum(mChoice_Get_base_window_p());
    mBGMPsComp_make_ps_fanfare(0x28, 0x168);
}

static int Player_actor_MessageControl_Notice_rod(ACTOR* actor, GAME* game, int end_flag) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actor;
    mPlayer_main_notice_rod_c* main_notice = &player->main_data.notice_rod;
    int* state_p = &main_notice->state;
    mMsg_Window_c* win = mMsg_Get_base_window_p();
    int choice;

    if (main_notice->timer < 42.0f) {
        main_notice->timer += (f32)gamePT->graph->dt_num_60fps_frames;
        return -1;
    }

    switch (*state_p) {
        case 0:

            if (!mDemo_Check(mDemo_TYPE_REPORT, actor)) {
                mDemo_Request(mDemo_TYPE_REPORT, actor, Player_actor_Notice_rod_demo_ct);
            } else if (main_notice->already_collected) {
                *state_p = 1;
            } else {
                *state_p = 3;
            }

            return -1;

        case 1:
            if (end_flag) {
                Player_actor_AppearMark_Notice_rod(actor);
                if (mMsg_Check_MainNormalContinue(win)) {
                    mMsg_Set_continue_msg_num(win, 0x134A);
                    mMsg_Unset_LockContinue(win);
                    *state_p = 2;
                }
            }
            return -1;

        case 2:
            if (!mMsg_Check_MainNormal(win)) {
#if VERSION >= VER_GAFU01_00
                Player_actor_InitAnimation_Base2(actor, game, mPlayer_ANIM_YATTA2, mPlayer_ANIM_YATTA2, 1.0f, 1.0f,
                                                 0.6f, -5.0f, 0, 0);
#else
                Player_actor_InitAnimation_Base2(actor, game, mPlayer_ANIM_YATTA2, mPlayer_ANIM_YATTA2, 1.0f, 1.0f,
                                                 0.5f, -5.0f, 0, 0);
#endif
                mBGMPsComp_delete_ps_fanfare(0x28, 0x168);
                mBGMPsComp_make_ps_fanfare(0x4C, 0x168);
                mMsg_Set_LockContinue(win);
                Player_actor_DeleteMark_Notice_rod(actor);

                *state_p = 3;
            }
            return -1;

        case 3:

            if (end_flag) {
                if (!main_notice->already_collected) {
                    Player_actor_AppearMark_Notice_rod(actor);
                }
                if (main_notice->not_full_pocket) {
                    mMsg_Set_CancelNormalContinue(win);
                    *state_p = 5;
                } else {
                    mMsg_Set_continue_msg_num(win, 0x1348);
                    *state_p = 4;
                }
                mMsg_Unset_LockContinue(win);
            }
            return -1;

        case 4:
            choice = mChoice_Get_ChoseNum(mChoice_Get_base_window_p());

            if (choice == mChoice_CHOICE0) {
                main_notice->exchange_flag = TRUE;
                *state_p = 5;
            } else if (choice == mChoice_CHOICE1) {
                main_notice->exchange_flag = FALSE;
                *state_p = 5;
            }

            return -1;

        case 5:
            if (!mDemo_Check(mDemo_TYPE_REPORT, actor)) {
                *state_p = 6;
                Player_actor_DeleteMark_Notice_rod(actor);
            }
            return -1;

        default:
            if (main_notice->not_full_pocket) {
                return 0x39;
            } else {
                return !main_notice->exchange_flag ? 0x53 : 0x39;
            }
    }
}

static void Player_actor_request_proc_index_fromNotice_rod(ACTOR* actor, GAME* game, int msg_control) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actor;
    mPlayer_main_notice_rod_c* main_notice = &player->main_data.notice_rod;
    UKI_ACTOR* uki;

    switch (msg_control) {
        case 0x39:
            Player_actor_request_main_putaway_rod(game, main_notice->angle_y, main_notice->exchange_flag,
                                                  mPlayer_REQUEST_PRIORITY_29);
            break;

        case 0x53:
            uki = (UKI_ACTOR*)player->fishing_rod_actor_p;

            if (uki != NULL) {
                mPlayer_request_release_creature_u release_data;
                ACTOR* fish = uki->child_actor;

                bzero(&release_data, sizeof(mPlayer_request_release_creature_u));
                Player_actor_request_main_release_creature_all(game, 1, 0, &release_data, fish,
                                                               mPlayer_REQUEST_PRIORITY_30);
            }

            break;
    }
}

static void Player_actor_main_Notice_rod(ACTOR* actor, GAME* game) {
    f32 frame_calc;
    int end_flag;
    int cntrl;

    Player_actor_Movement_Notice_rod(actor);
    end_flag = Player_actor_CulcAnimation_Notice_rod(actor, &frame_calc);
    Player_actor_Reinput_force_position_angle(actor, game);
    Player_actor_SearchAnimation_Notice_rod(actor, game, frame_calc);
    Player_actor_recover_lean_angle(actor);
    Player_actor_set_eye_pattern_Notice_rod(actor, end_flag);
    Player_actor_ObjCheck_Notice_rod(actor, game);
    Player_actor_BGcheck_Notice_rod(actor);
    cntrl = Player_actor_MessageControl_Notice_rod(actor, game, end_flag);
    Player_actor_Item_main(actor, game);
    Player_actor_request_proc_index_fromNotice_rod(actor, game, cntrl);
}
