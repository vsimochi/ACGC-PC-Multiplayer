        {FALSE, 0x0100, 0x00},
        {FALSE, 0x0100, 0x00},
        {FALSE, 0x0100, 0x00},
        {FALSE, 0x0400, 0x00},
        {FALSE, 0x0400, 0x00},
        {FALSE, 0x0400, 0x00},
        {FALSE, 0x0400, 0x00},
        {FALSE, 0x0400, 0x00},
        {FALSE, 0x0400, 0x00},
        {FALSE, 0x0800, 0x00},
        { TRUE, 0x0400, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
        {FALSE, 0x0000, 0x00},
