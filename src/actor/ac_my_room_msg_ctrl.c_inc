static void aMR_SetSlotString(void) {
    u8 str[mMsg_FREE_STRING_LEN];
    int slot = famicom_getErrorChan();

    mString_Load_StringFromRom(str, mMsg_FREE_STRING_LEN, 0x6CD + (slot & 1));
    mMsg_Set_free_str(mMsg_Get_base_window_p(), mMsg_FREE_STR4, str, mMsg_FREE_STRING_LEN);
}

static int aMR_GetCardFamicomCount(void) {
    int count = 0;

    if (famicom_get_disksystem_titles(&count, NULL, 0) != FALSE) {
        return count;
    }

    return 0;
}

static u8* aMR_GetNameString(MY_ROOM_ACTOR* my_room, int rom_no) {
    static u8 dummy[FAMICOM_MORI_NAME_LEN] = { 'n', 'o', ' ', 'g', 'a', 'm', 'e', ' ',
                                               ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ' };

    if (my_room->emu_info.famicom_names_p != NULL && rom_no < my_room->emu_info.card_famicom_count) {
        return (u8*)my_room->emu_info.famicom_names_p + rom_no * FAMICOM_MORI_NAME_LEN;
    }

    return dummy;
}

static void aMR_SetMemoryCardGameIndex(MY_ROOM_ACTOR* my_room, int sub_index) {
    my_room->emu_info.rom_no = -(my_room->emu_info.memory_game_select + sub_index);
}

static void aMR_ReportDisplayMemoryGameSelectCount(MY_ROOM_ACTOR* my_room, int add_amount) {
    my_room->emu_info.memory_game_select += add_amount;

    if (my_room->emu_info.memory_game_select >= my_room->emu_info.card_famicom_count) {
        my_room->emu_info.memory_game_select = 0;
    }
}

static FTR_ACTOR* aMR_GetNowDemoFtr(ACTOR* actorx) {
    MY_ROOM_ACTOR* my_room = (MY_ROOM_ACTOR*)actorx;

    return l_aMR_work.ftr_actor_list + my_room->demo_ftrID;
}

static void aMR_ChangeDemoFtrStatus(ACTOR* actorx, s16 status) {
    FTR_ACTOR* ftr_actor = aMR_GetNowDemoFtr(actorx);

    ftr_actor->demo_status = status;
}

static int aMR_GetMusicCountInMusicBox(void) {
    int i;
    int count = 0;

    for (i = 0; i < MINIDISK_NUM; i++) {
        u32* music_box = Save_Get(scene_no) == SCENE_COTTAGE_MY
                             ? Save_Get(island).cottage.music_box
                             : Save_Get(homes[mHS_get_arrange_idx(Common_Get(player_no))]).music_box;
#ifdef TARGET_PC
        /* roommates (pc_room_ui.c): a GUEST editing a shared house uses THAT house's music box (the arrangement says house 0 for player_no 4) */
        if (Save_Get(scene_no) != SCENE_COTTAGE_MY) {
            music_box = Save_Get(homes[pc_room_music_box_house()]).music_box;
        }
#endif

        if (((music_box[(i / 32) & 1] >> (i & 31)) & 1) == 1) {
            count++;
        }
    }

    return count;
}

static void aMR_MemoryMusicBoxStatus(MY_ROOM_ACTOR* my_room) {
    u32* music_box = Save_Get(scene_no) == SCENE_COTTAGE_MY
                         ? Save_Get(island).cottage.music_box
                         : Save_Get(homes[mHS_get_arrange_idx(Common_Get(player_no))]).music_box;
#ifdef TARGET_PC
    /* roommates (pc_room_ui.c): a GUEST editing a shared house uses THAT house's music box (the arrangement says house 0 for player_no 4) */
    if (Save_Get(scene_no) != SCENE_COTTAGE_MY) {
        music_box = Save_Get(homes[pc_room_music_box_house()]).music_box;
    }
#endif
    int i;

    for (i = 0; i < 2; i++) {
        my_room->music_box[i] = music_box[i];
    }
}

static void aMR_SetEmulatorMessage_CanSave(ACTOR* actorx) {
    mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x17B5);
    mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
    mMsg_Set_ForceNext(mMsg_Get_base_window_p());
}

static void aMR_SetEmulatorStartMessage(ACTOR* actorx, int internal_rom) {
    MY_ROOM_ACTOR* my_room = (MY_ROOM_ACTOR*)actorx;
    int res;

    Common_Get(my_room_message_control_flags) |= (1 << 2);

    if (internal_rom == TRUE) {
        res = famicom_internal_data_load();
    } else {
        if (Common_Get(player_no) < PLAYER_NUM) {
            aMR_SetEmulatorMessage_CanSave(actorx);
            aMR_SetSlotString();
            return;
        }

        res = famicom_external_data_save_check();
    }

    aMR_SetSlotString();

    switch (res) {
        case FAMICOM_RESULT_OK:
            my_room->requested_msg_type = aMR_MSG_STATE_EXPLAIN_EMULATOR;
            aMR_SetEmulatorMessage_CanSave(actorx);
            break;
        case FAMICOM_RESULT_NOSPACE:
            my_room->requested_msg_type = aMR_MSG_STATE_EXPLAIN_EMULATOR;
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x3B50);
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            break;
        case FAMICOM_RESULT_NOENTRY:
            my_room->requested_msg_type = aMR_MSG_STATE_EXPLAIN_EMULATOR;
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x3B51);
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            break;
        case FAMICOM_RESULT_BROKEN:
            my_room->requested_msg_type = aMR_MSG_STATE_EXPLAIN_EMULATOR;
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x3B52);
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            break;
        case FAMICOM_RESULT_WRONGDEVICE:
            my_room->requested_msg_type = aMR_MSG_STATE_EXPLAIN_EMULATOR;
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x3B53);
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            break;
        case FAMICOM_RESULT_WRONGENCODING:
            my_room->requested_msg_type = aMR_MSG_STATE_EXPLAIN_EMULATOR;
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x3B54);
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            break;
        case FAMICOM_RESULT_NOCARD:
            my_room->requested_msg_type = aMR_MSG_STATE_EXPLAIN_EMULATOR;
            mMsg_Set_free_str(mMsg_Get_base_window_p(), mMsg_FREE_STR0, Save_Get(land_info).name, LAND_NAME_SIZE);
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x3B55);
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            break;
        default:
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x3071);
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            my_room->requested_msg_type = aMR_MSG_STATE_WAIT_FAMICOM_BATU;
            Common_Get(my_room_message_control_flags) &= ~4;
            break;
    }
}

static void aMR_NoMsgInit(ACTOR* actorx) {
    // nothing
}

static void aMR_NoMsgControl(ACTOR* actorx, GAME* game) {
    // nothing
}

#ifdef TARGET_PC
/* Client inside its OWN house with the house link down / not reconciled (pc_net_game_client_room_edit_locked): the drawer / music-box contents
 * and the furniture switch must not change (the choice is treated as "cancel", pockets and furniture untouched). */
static int aMR_PcEditLocked(void) {
    if (pc_net_game_client_room_edit_locked()) {
        pc_net_game_room_edit_denied();
        return TRUE;
    }
    return FALSE;
}
#else
#define aMR_PcEditLocked() FALSE
#endif

#ifdef TARGET_PC
/* Dresser storage (multiplayer CLIENT on a host with the feature ON: pc_net_game_dresser_available()). The take-out list of a dresser gets one extra
 * choice "More storage" (before Cancel) that opens a paged list of the host-side pool (<= 3 items + Put in + Next + Cancel <= 6 choices). Every pool
 * change is a host transaction (TXN kind 18): the pockets change ONLY through the host's post-image; the dresser stays open (the player cannot use the
 * pockets) until the result is in. available() == 0 (single player, the host's own dresser, an old host, feature off): nothing below is reached. */
static int aMR_pc_storage_choice = -1; /* the choice index of "More storage" in the current take-out list, -1 = not offered */
static int aMR_pc_dresser_page = 0;
static int aMR_pc_dresser_map[mChoice_CHOICE_NUM]; /* >= 0 pool slot (take out), -1 put in, -2 next page, -3 cancel */
static int aMR_pc_dresser_putin = FALSE;   /* the next ITEM_PUT_IN goes to the pool */
static int aMR_pc_txn_from_submenu = FALSE;
static int aMR_pc_txn_resolved = FALSE;
static int aMR_pc_txn_last = 0; /* PC_NETGAME_TS_OP_* of the last resolved dresser transaction */
#ifdef PC_NET_TEST_HOOKS
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include "pc_test_hooks.h"
static int aMR_pc_ui_test = FALSE; /* TEST-ONLY: the UI states are driven by aMR_PcDresserUiTestHook (no real window) */
static int aMR_pc_ui_mode = 0;     /* TEST-ONLY: 0 put + take, 1 put only, 2 take only */
static int aMR_pc_ui_sel_ftr = -1; /* TEST-ONLY: the furniture actor the UI test uses as the dresser */
extern void pc_net_game_dresser_test_left_room(void);
#endif

#include "pc_dresser_ui.h" /* the dresser mode of the gyroid overlay */
#include "pc_dresser_items.h" /* the vanilla-slot filter */
#include "pc_nook_house.h" /* pc_dresser_msg_arm / pc_dresser_msg_more_choice (the "More storage" choice patch), pc_nook_msg_id (the refusal line) */

/* "More storage" picked in a patched empty / 1-item / 2-item owner dresser message: "which one?" then the pool page. 1 = handled. */
/* "More storage": the GYROID-STYLE overlay in dresser mode (pc_dresser_ui) when the opened dresser's host view is ready; the paged choice list only as the
 * fallback (no view yet). */
static void aMR_PcDresserOpenStorage(MY_ROOM_ACTOR* my_room) {
    aMR_pc_dresser_page = 0;
    if (pc_net_game_dresser_view_ready()) {
        my_room->requested_msg_type = aMR_MSG_STATE_PC_DRESSER_GYROID;
        mMsg_Set_CancelNormalContinue(mMsg_Get_base_window_p());
    } else {
        my_room->requested_msg_type = aMR_MSG_STATE_PC_DRESSER_WAIT_PAGE;
        mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x2F1E);
    }
    mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
}

static int aMR_PcDresserMoreChoice(MY_ROOM_ACTOR* my_room, int msg_no, int choice) {
    if (choice < 0 || choice != pc_dresser_msg_more_choice(msg_no)) {
        return FALSE;
    }
    pc_dresser_msg_arm(-1);
    aMR_PcDresserOpenStorage(my_room);
    return TRUE;
}

/* v2 per-dresser identity of a furniture actor of the OWN room: floor, layer, origin cell (the cell the house image stores the furniture id in, the same cell
 * aMR_KeepItem2Fg writes the vanilla keep items above) and the furniture item. 0 = not resolvable (not the own room, not a player house floor). */
static int aMR_CheckRoomOwner(u32 player_no, MY_ROOM_ACTOR* my_room); /* ac_my_room.c */
int aMR_pc_ftr_is_item_storage(int ftr_item);                        /* ac_my_room.c (TARGET_PC) */
static int aMR_PcDresserIdent(MY_ROOM_ACTOR* my_room, FTR_ACTOR* ftr_actor, int* floor, int* ut_x, int* ut_z, int* item) {
    if (my_room == NULL || ftr_actor == NULL || !aMR_CheckRoomOwner(Common_Get(player_no), my_room) || my_room->scene == SCENE_COTTAGE_MY) {
        return FALSE;
    }
    *floor = mFI_GetPlayerHouseFloorNo(my_room->scene);
    if (*floor < 0 || *floor > 2 || !aMR_Wpos2PlaceNumber(ut_x, ut_z, ftr_actor->position, ftr_actor->shape_type) || *ut_x < 0 || *ut_z < 0) {
        return FALSE;
    }
    *item = (int)mRmTp_FtrIdx2FtrItemNo(ftr_actor->name, mRmTp_DIRECT_SOUTH);
    return TRUE;
}

/* Option A: a dresser of the own room whose EXTRA storage is not empty may not be moved / rotated / picked up (the extra items stay with this cell on the host).
 * 1 = refuse. Single player / feature off / an empty dresser: 0 (vanilla). */
static void aMR_PcDresserSelectFtr(MY_ROOM_ACTOR* my_room, FTR_ACTOR* ftr_actor);
static int aMR_PcDresserOn(void);
static int aMR_CheckRoomOwner(u32 player_no, MY_ROOM_ACTOR* my_room);

/* 6j: TRUE = do not start the open demo of this own item-storage piece now (its move of this visit is not committed yet; notice 4). Owner / own house / feature on /
 * not edit-locked only; anything else FALSE (vanilla). */
static int aMR_PcDresserOpenRefused(MY_ROOM_ACTOR* my_room, FTR_ACTOR* ftr_actor) {
    int floor, ut_x, ut_z, item;
    if (!aMR_PcDresserOn() || !aMR_CheckRoomOwner(Common_Get(player_no), my_room) || Save_Get(scene_no) == SCENE_NPC_HOUSE ||
        Save_Get(scene_no) == SCENE_COTTAGE_NPC || aMR_PcEditLocked() || !aMR_PcDresserIdent(my_room, ftr_actor, &floor, &ut_x, &ut_z, &item) ||
        !aMR_pc_ftr_is_item_storage(item)) {
        return FALSE;
    }
    return pc_net_game_dresser_open_gate(floor, ftr_actor->layer, ut_x, ut_z, item) == 1;
}

/* Option A move lock (pickup / push / pull / rotate grab), AUTHORITATIVE: only an item-storage furniture of the own room can be locked; it is allowed only when
 * the host answered a SELECT of THIS dresser in THIS room visit with 0 extra items (or no extra storage can exist: offline / host without the feature). Extra
 * items -> refused; state unknown -> refused too (fail safe) and the host is asked, so a later attempt can succeed. Refusals show notice 3. */
#define aMR_PC_MOVE_PICKUP 1 /* the action of a move-lock check (diagnostics only: pc_net_game_dresser_move_attempt) */
#define aMR_PC_MOVE_PULL 2
#define aMR_PC_MOVE_PUSH 3
#define aMR_PC_MOVE_ROTATE 4
static int aMR_PcDresserMoveLocked(MY_ROOM_ACTOR* my_room, FTR_ACTOR* ftr_actor, int action) {
    int floor, ut_x, ut_z, item, st;
    if (action != aMR_PC_MOVE_PICKUP) {
        return FALSE; /* 6q (S2): push / pull / rotate of a dresser holding items are allowed (the host carries its storage to the new cell); only pickup stays locked */
    }
    if (!aMR_PcDresserIdent(my_room, ftr_actor, &floor, &ut_x, &ut_z, &item) || !aMR_pc_ftr_is_item_storage(item)) {
        return FALSE;
    }
    { /* 6l, 27-slot lock (feature on only): the 3 vanilla keep slots count too -- the live room's keep items, or the host's canonical ones (a take-out not
       * committed yet: the host's step 9b would refuse the move) */
        static int keep_logged = 0, wait_logged = 0;
        int i, live = 0, kl;
        for (i = 0; i < aFTR_KEEP_ITEM_COUNT; i++) {
            live |= ftr_actor->items[i] != EMPTY_NO;
        }
        kl = pc_net_game_dresser_keep_lock(floor, ftr_actor->layer, ut_x, ut_z, item, live);
        if (kl == 1) {
            pc_net_game_dresser_move_denied(); /* notice 3: "Take the stored items out first" */
            pc_net_game_dresser_move_attempt(action, item, ut_x, ut_z);
            if (keep_logged++ < 20)
            printf("[NET][DRESSER] client: dresser 0x%04X cell %d,%d holds vanilla keep item(s): move / rotate / pickup REFUSED (27-slot lock)\n", (unsigned)item, ut_x, ut_z);
            return TRUE;
        }
        if (kl == 2) {
            pc_net_game_dresser_move_wait(1); /* notice 4: the take-out is being saved */
            pc_net_game_dresser_move_attempt(action, item, ut_x, ut_z);
            if (wait_logged++ < 20)
            printf("[NET][DRESSER] client: dresser 0x%04X cell %d,%d: keep items taken out but not committed yet: move / rotate / pickup REFUSED for now (27-slot lock)\n",
                   (unsigned)item, ut_x, ut_z);
            return TRUE;
        }
    }
    st = pc_net_game_dresser_move_state(floor, ftr_actor->layer, ut_x, ut_z, item);
    if (st == 0) {
        return FALSE;
    }
    pc_net_game_dresser_move_attempt(action, item, ut_x, ut_z); /* 6l diagnostics: one count per refused attempt */
    if (st > 0) {
        pc_net_game_dresser_move_denied(); /* "Take the stored items out first" (the refused-house-edit notice line, value 3) */
    } else {
        /* 6l: UNKNOWN is never shown as "take the items out": notice 4 when the piece's cell is not committed yet (the room is being saved), else 6 (asking) */
        pc_net_game_dresser_move_wait(pc_net_game_dresser_cell_committed(floor, ftr_actor->layer, ut_x, ut_z, item) == 0);
    }
    if (st < 0) {
        static int logged = 0;
        if (logged++ < 20) {
            printf("[NET][DRESSER] client: dresser 0x%04X cell %d,%d: extra storage state UNKNOWN in this room visit -> refused, asking the host\n", (unsigned)item, ut_x,
                   ut_z);
        }
        if (pc_net_game_dresser_cell_committed(floor, ftr_actor->layer, ut_x, ut_z, item) != 0) {
            aMR_PcDresserSelectFtr(my_room, ftr_actor); /* 6j: never for a cell whose move is not committed (the host would refuse it) */
        }
    }
    return TRUE;
}

/* Selects the opened dresser on the host (v2): its STATE (the extra items) arrives shortly; the menus read pc_net_game_dresser_item() only when it did. */
static void aMR_PcDresserSelectFtr(MY_ROOM_ACTOR* my_room, FTR_ACTOR* ftr_actor) {
    static int last[5] = { -1, -1, -1, -1, -1 };
    static u32 asked_ms = 0; /* WALL-CLOCK time of the last SELECT (the caller runs every rendered frame: a frame count is 0.2 s on an uncapped client) */
    static unsigned int last_visit = 0;
    int floor, ut_x, ut_z, item;
    if (last_visit != pc_net_game_dresser_visit()) { /* a new room visit: every dresser is asked again (the move lock needs THIS visit's answer) */
        last_visit = pc_net_game_dresser_visit();
        last[0] = last[1] = last[2] = last[3] = last[4] = -1;
        asked_ms = 0;
    }
    if (pc_net_game_dresser_available() && aMR_PcDresserIdent(my_room, ftr_actor, &floor, &ut_x, &ut_z, &item)) {
        if (last[0] == floor && last[1] == ftr_actor->layer && last[2] == ut_x && last[3] == ut_z && last[4] == item &&
            (pc_net_game_dresser_view_ready() || (s32)(pc_net_game_now_ms() - asked_ms) < 3000)) {
            return; /* already selected / its answer is on the way (this function runs every frame of the open-wait); re-asked after 3 s without an answer
                     * (the re-ask of the SAME piece keeps its generation, pc_net_game_dresser_select: a slow first answer is still adopted) */
        }
        asked_ms = pc_net_game_now_ms() | 1u;
        if (pc_net_game_dresser_select(floor, ftr_actor->layer, ut_x, ut_z, item) != 0) {
            last[0] = floor;
            last[1] = ftr_actor->layer;
            last[2] = ut_x;
            last[3] = ut_z;
            last[4] = item;
        }
    }
}

static int aMR_PcDresserOn(void) {
    return pc_net_game_dresser_available() && !pc_net_game_client_room_edit_locked();
}

/* The put-in submenu already removed `item` from pocket `slot` locally: put it BACK (the pre-image the host validates) and ask the host to move it into the
 * pool. 1 = the transaction runs (state PC_DRESSER_TXN), 0 = refused locally (the item stays in the pocket). Never touches the 3 vanilla slots. */
static int aMR_PcDresserPutInPool(MY_ROOM_ACTOR* my_room, mActor_name_t item, int slot) {
    Private_c* priv = Common_Get(now_private);

    if (item == EMPTY_NO || slot < 0 || slot >= mPr_POCKETS_SLOT_COUNT || priv->inventory.pockets[slot] != EMPTY_NO) {
        return FALSE;
    }
    mPr_SetPossessionItem(priv, slot, item, mPr_ITEM_COND_NORMAL);
    if (pc_net_game_dresser_begin(1, 0xFF, slot, item) != 1) {
        return FALSE;
    }
    aMR_pc_txn_from_submenu = TRUE;
    aMR_pc_txn_resolved = FALSE;
    my_room->requested_msg_type = aMR_MSG_STATE_PC_DRESSER_TXN;
    return TRUE;
}
#endif

static void aMR_MsgControlOwnerNoItem(ACTOR* actorx, GAME* game) {
    MY_ROOM_ACTOR* my_room = (MY_ROOM_ACTOR*)actorx;
    int choice = mChoice_Get_ChoseNum(mChoice_Get_base_window_p());

    if (choice != -1 && aMR_PcEditLocked()) {
        my_room->requested_msg_type = aMR_MSG_STATE_REQUEST_CLOSE_FTR;
        mMsg_Set_CancelNormalContinue(mMsg_Get_base_window_p());
        mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
        return;
    }
#ifdef TARGET_PC
    if (aMR_PcDresserMoreChoice(my_room, MSG_2570, choice)) {
        mChoice_Clear_ChoseNum(mChoice_Get_base_window_p());
        return;
    }
#endif

    if (choice != -1) {
        switch (choice) {
            case mChoice_CHOICE0: {
                if (mSM_check_open_inventory_itemlist(mSM_IV_OPEN_PUTIN_FTR, 0) == FALSE) {
                    my_room->requested_msg_type = aMR_MSG_STATE_REQUEST_CLOSE_FTR;
                    mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x0A10);
                    mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
                } else {
                    my_room->requested_msg_type = aMR_MSG_STATE_OPEN_SUBMENU;
                    mMsg_Set_CancelNormalContinue(mMsg_Get_base_window_p());
                    mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
                }

                break;
            }

            default: {
                my_room->requested_msg_type = aMR_MSG_STATE_REQUEST_CLOSE_FTR;
                mMsg_Set_CancelNormalContinue(mMsg_Get_base_window_p());
                mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
                break;
            }
        }
    }
}

static void aMR_MsgInitOwnerWhichPutOut(ACTOR* actorx) {
    MY_ROOM_ACTOR* my_room = (MY_ROOM_ACTOR*)actorx;
    static u8 item_name1[mIN_ITEM_NAME_LEN];
    static u8 item_name2[mIN_ITEM_NAME_LEN];
    static u8 item_name3[mIN_ITEM_NAME_LEN];
    static u8* item_name_table[] = { item_name1, item_name2, item_name3 };
    u8 cancel_str[mChoice_CHOICE_STRING_LEN];
    FTR_ACTOR* ftr_actor = l_aMR_work.ftr_actor_list + my_room->demo_ftrID;
    mChoice_c* choice_win = mChoice_Get_base_window_p();
    int count;
    int i;

    aMR_TidyItemInFurniture(ftr_actor);
    count = aMR_GetItemCountInFurniture(ftr_actor);
    mChoice_Clear_ChoseNum(choice_win);

    for (i = 0; i < count; i++) {
        if (ftr_actor->items[i] != EMPTY_NO) {
            mIN_copy_name_str(item_name_table[i], ftr_actor->items[i]);
        }
    }

    if (my_room->msg_type == aMR_MSG_STATE_OWNER_WHICH_PUT_OUT1) {
        for (i = 0; i < aFTR_KEEP_ITEM_COUNT; i++) {
            if (ftr_actor->items[i] != EMPTY_NO) {
                mMsg_Set_item_str_art(mMsg_Get_base_window_p(), i, item_name_table[i], mIN_ITEM_NAME_LEN,
                                      mIN_get_item_article(ftr_actor->items[i]));
            }
        }
    }

    mChoice_Load_ChoseStringFromRom(choice_win, cancel_str, 0x29, NULL);
    if (count == 1) {
        mChoice_Set_choice_data(choice_win, item_name_table[0], mIN_ITEM_NAME_LEN, cancel_str,
                                mChoice_CHOICE_STRING_LEN, NULL, mIN_ITEM_NAME_LEN, NULL, mIN_ITEM_NAME_LEN, NULL,
                                mIN_ITEM_NAME_LEN, NULL, mIN_ITEM_NAME_LEN);
    } else if (count == 2) {
        mChoice_Set_choice_data(choice_win, item_name_table[0], mIN_ITEM_NAME_LEN, item_name_table[1],
                                mIN_ITEM_NAME_LEN, cancel_str, mChoice_CHOICE_STRING_LEN, NULL, mIN_ITEM_NAME_LEN, NULL,
                                mIN_ITEM_NAME_LEN, NULL, mIN_ITEM_NAME_LEN);
    } else if (count == 3) {
        mChoice_Set_choice_data(choice_win, item_name_table[0], mIN_ITEM_NAME_LEN, item_name_table[1],
                                mIN_ITEM_NAME_LEN, item_name_table[2], mIN_ITEM_NAME_LEN, cancel_str,
                                mChoice_CHOICE_STRING_LEN, NULL, mIN_ITEM_NAME_LEN, NULL, mIN_ITEM_NAME_LEN);
    }
#ifdef TARGET_PC
    aMR_pc_storage_choice = -1;
    if (count >= 1 && count <= 3 && aMR_PcDresserOn()) {
        /* the same list + "More storage" right before Cancel (<= 5 choices) */
        static u8 storage_str[] = "More storage";
        u8* s[mChoice_CHOICE_NUM] = { NULL, NULL, NULL, NULL, NULL, NULL };
        int l[mChoice_CHOICE_NUM] = { 0, 0, 0, 0, 0, 0 };
        for (i = 0; i < count; i++) {
            s[i] = item_name_table[i];
            l[i] = mIN_ITEM_NAME_LEN;
        }
        s[count] = storage_str;
        l[count] = (int)sizeof(storage_str) - 1;
        s[count + 1] = cancel_str;
        l[count + 1] = mChoice_CHOICE_STRING_LEN;
        aMR_pc_storage_choice = count;
        mChoice_Set_choice_data(choice_win, s[0], l[0], s[1], l[1], s[2], l[2], s[3], l[3], s[4], l[4], s[5], l[5]);
    }
#endif
}

static void aMR_MsgControlOwnerWhichPutOut(ACTOR* actorx, GAME* game) {
    MY_ROOM_ACTOR* my_room = (MY_ROOM_ACTOR*)actorx;
    int choice_no = mChoice_Get_ChoseNum(mChoice_Get_base_window_p());

    mChoice_Clear_ChoseNum(mChoice_Get_base_window_p());
    if (choice_no != -1 && aMR_PcEditLocked()) {
        my_room->requested_msg_type = aMR_MSG_STATE_REQUEST_CLOSE_FTR;
        mMsg_Set_CancelNormalContinue(mMsg_Get_base_window_p());
        mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
        return;
    }
#ifdef TARGET_PC
    if (choice_no != -1 && aMR_pc_storage_choice >= 0 && choice_no == aMR_pc_storage_choice) {
        /* "More storage": the gyroid-style dresser overlay (fallback: "which one?" + the paged pool list) */
        aMR_pc_storage_choice = -1;
        aMR_PcDresserOpenStorage(my_room);
        return;
    }
#endif
    if (choice_no != -1) {
        FTR_ACTOR* ftr_actor = aMR_GetNowDemoFtr(actorx);

        if (choice_no < aMR_GetItemCountInFurniture(ftr_actor)) {
            int idx = mPr_GetPossessionItemIdxWithCond(Common_Get(now_private), EMPTY_NO, mPr_ITEM_COND_NORMAL);

            if (idx != -1) {
                mActor_name_t item = ftr_actor->items[choice_no];

                ftr_actor->items[choice_no] = EMPTY_NO;
                aMR_TidyItemInFurniture(ftr_actor);
                my_room->requested_msg_type = aMR_MSG_STATE_REQUEST_CLOSE_FTR;
                mPr_SetPossessionItem(Common_Get(now_private), idx, item, mPr_ITEM_COND_NORMAL);
                mMsg_Set_CancelNormalContinue(mMsg_Get_base_window_p());
                mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            } else {
                /* Full pockets */
                my_room->requested_msg_type = aMR_MSG_STATE_REQUEST_CLOSE_FTR;
                mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x0A0E);
                mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            }
        } else {
            /* Cancelled */
            my_room->requested_msg_type = aMR_MSG_STATE_REQUEST_CLOSE_FTR;
            mMsg_Set_CancelNormalContinue(mMsg_Get_base_window_p());
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
        }
    }
}

